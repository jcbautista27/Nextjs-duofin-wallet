# Variables de entorno para Duofin

# Conexión a PostgreSQL (Neon / Supabase)
# - En Supabase, DIRECT_URL = conexión directa (puerto 5432) para migraciones
#   (las usa prisma.config.ts para el CLI).
# - DATABASE_URL = conexión por pooler (usada por el cliente runtime, src/lib/prisma.ts).
# - Si usas Neon/Supabase sin pooler, ambas pueden apuntar al mismo host.
DATABASE_URL="postgresql://usuario:contraseña@host:5432/dbname"
DIRECT_URL="postgresql://usuario:contraseña@host:5432/dbname"

# NextAuth.js — genera el secret con: openssl rand -base64 32
NEXTAUTH_SECRET=""

# URL de la app (local o producción)
NEXTAUTH_URL="http://localhost:3000"
